# Generated by VS Code Aster - https://github.com/simvia-tech/vs-code-aster
# Scenario: Linear elastic static analysis (MODELISATION="3D")

DEBUT(CODE=_F(NIV_PUB_WEB="INTERNET"), LANG="EN")

mesh = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)

model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"),
)

material = DEFI_MATERIAU(ELAS=_F(E=210000.0, NU=0.3))

material_field = AFFE_MATERIAU(
    MAILLAGE=mesh,
    AFFE=_F(GROUP_MA=("SOLID",), MATER=material),
)

boundary_condition = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_MA=("CLAMP",), DX=0.0, DY=0.0, DZ=0.0),
)

load = AFFE_CHAR_MECA(
    MODELE=model,
    PRES_REP=_F(GROUP_MA=("LOAD_FACE",), PRES=100000.0),
)

result = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=material_field,
    EXCIT=(_F(CHARGE=boundary_condition), _F(CHARGE=load)),
)

result = CALC_CHAMP(
    reuse=result,
    RESULTAT=result,
    CONTRAINTE=("SIGM_ELNO",),
    CRITERES=("SIEQ_ELNO",),
)

IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=_F(RESULTAT=result),
)

FIN()
