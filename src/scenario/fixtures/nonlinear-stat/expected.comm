# Generated by VS Code Aster - https://github.com/simvia-tech/vs-code-aster
# Scenario: Nonlinear static analysis (MODELISATION="3D")

DEBUT(CODE=_F(NIV_PUB_WEB="INTERNET"), LANG="EN")

mesh = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)

model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"),
)

material = DEFI_MATERIAU(
    ELAS=_F(E=210000.0, NU=0.3),
    ECRO_LINE=_F(SY=250.0, D_SIGM_EPSI=2000.0),
)

material_field = AFFE_MATERIAU(
    MAILLAGE=mesh,
    AFFE=_F(GROUP_MA=("SOLID",), MATER=material),
)

boundary_condition = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_MA=("CLAMP",), DX=0.0, DY=0.0, DZ=0.0),
)

load = AFFE_CHAR_MECA(
    MODELE=model,
    PRES_REP=_F(GROUP_MA=("LOAD_FACE",), PRES=100000.0),
)

load_ramp = DEFI_FONCTION(
    NOM_PARA="INST",
    VALE=(0.0, 0.0, 1.0, 1.0),
    PROL_DROITE="LINEAIRE",
    PROL_GAUCHE="CONSTANT",
)

time_list = DEFI_LIST_REEL(
    DEBUT=0.0,
    INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=10),
)

result = STAT_NON_LINE(
    MODELE=model,
    CHAM_MATER=material_field,
    EXCIT=(
        _F(CHARGE=boundary_condition),
        _F(CHARGE=load, FONC_MULT=load_ramp),
    ),
    COMPORTEMENT=_F(RELATION="VMIS_ISOT_LINE", DEFORMATION="PETIT"),
    INCREMENT=_F(LIST_INST=time_list),
    NEWTON=_F(REACTUALISATION="TANGENTE", MATRICE="TANGENTE"),
    CONVERGENCE=_F(RESI_GLOB_RELA=1e-6, ITER_GLOB_MAXI=20),
)

result = CALC_CHAMP(
    reuse=result,
    RESULTAT=result,
    CONTRAINTE=("SIGM_ELNO",),
    CRITERES=("SIEQ_ELNO",),
)

IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=_F(RESULTAT=result),
)

FIN()
