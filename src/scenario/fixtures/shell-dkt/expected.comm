# Generated by VS Code Aster - https://github.com/simvia-tech/vs-code-aster
# Scenario: Linear elastic static analysis (MODELISATION="DKT")

DEBUT(CODE=_F(NIV_PUB_WEB="INTERNET"), LANG="EN")

mesh = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)

model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="DKT"),
)

material = DEFI_MATERIAU(ELAS=_F(E=210000.0, NU=0.3))

material_field = AFFE_MATERIAU(
    MAILLAGE=mesh,
    AFFE=_F(GROUP_MA=("PANEL",), MATER=material),
)

element_properties = AFFE_CARA_ELEM(
    MODELE=model,
    COQUE=_F(GROUP_MA=("PANEL",), EPAIS=0.01, VECTEUR=(0.0, 0.0, 1.0)),
)

boundary_condition = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_MA=("CLAMP",), DX=0.0, DY=0.0, DZ=0.0, DRX=0.0, DRY=0.0, DRZ=0.0),
)

load = AFFE_CHAR_MECA(
    MODELE=model,
    PRES_REP=_F(GROUP_MA=("PANEL",), PRES=1000.0),
)

result = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=material_field,
    CARA_ELEM=element_properties,
    EXCIT=(_F(CHARGE=boundary_condition), _F(CHARGE=load)),
)

result = CALC_CHAMP(
    reuse=result,
    RESULTAT=result,
    CONTRAINTE=("SIGM_ELNO",),
    CRITERES=("SIEQ_ELNO",),
)

IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=_F(RESULTAT=result),
)

FIN()
