# Generated by VS Code Aster - https://github.com/simvia-tech/vs-code-aster
# Scenario: Modal analysis (MODELISATION="3D")

DEBUT(CODE=_F(NIV_PUB_WEB="INTERNET"), LANG="EN")

mesh = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)

model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"),
)

material = DEFI_MATERIAU(ELAS=_F(E=210000.0, NU=0.3, RHO=7800.0))

material_field = AFFE_MATERIAU(
    MAILLAGE=mesh,
    AFFE=_F(GROUP_MA=("SOLID",), MATER=material),
)

boundary_condition = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_MA=("CLAMP",), DX=0.0, DY=0.0, DZ=0.0),
)

rigidity_elem = CALC_MATR_ELEM(
    OPTION="RIGI_MECA",
    MODELE=model,
    CHAM_MATER=material_field,
    CHARGE=boundary_condition,
)

mass_elem = CALC_MATR_ELEM(
    OPTION="MASS_MECA",
    MODELE=model,
    CHAM_MATER=material_field,
    CHARGE=boundary_condition,
)

dof_numbering = NUME_DDL(MATR_RIGI=rigidity_elem)

stiffness_matrix = ASSE_MATRICE(MATR_ELEM=rigidity_elem, NUME_DDL=dof_numbering)

mass_matrix = ASSE_MATRICE(MATR_ELEM=mass_elem, NUME_DDL=dof_numbering)

modes = CALC_MODES(
    MATR_RIGI=stiffness_matrix,
    MATR_MASS=mass_matrix,
    OPTION="PLUS_PETITE",
    CALC_FREQ=_F(NMAX_FREQ=10),
)

IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=_F(RESULTAT=modes),
)

FIN()
